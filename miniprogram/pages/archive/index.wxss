/* B8 赛后归档页样式（设计 token 与 respond 一致） */
.page {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #f6f6f6;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载占位 */
.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ── 区1：比赛信息 ── */
.status-bar {
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.status-bar-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.vs-block {
  text-align: center;
  margin-bottom: 20rpx;
}
.vs {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}
.sport {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.info-row {
  display: flex;
  padding: 12rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.info-label {
  width: 160rpx;
  color: #999;
  font-size: 28rpx;
  flex-shrink: 0;
}
.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.info-confirmer {
  color: #33c275;
  font-weight: 600;
}

/* 非橙态提示 */
.warn-tip {
  background: #fff7ec;
  border: 1rpx solid #ffe0b3;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #ad6800;
  line-height: 1.5;
}

/* ── 区2：归档表单 ── */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.form-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 24rpx;
  display: block;
}
.input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}
.perm-hint {
  font-size: 24rpx;
  color: #b34a48;
  background: #fff8f8;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

/* 401/403 绑定引导块（与 respond 同款） */
.guest-block {
  background: #fff7f8;
  border: 1rpx solid #f2c7cd;
  border-radius: 16rpx;
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.guest-block-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #7a1733;
}
.guest-block-desc {
  font-size: 26rpx;
  color: #8c5058;
  line-height: 1.6;
  text-align: center;
  margin: 20rpx 0 36rpx;
}
.guest-block-btn {
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #7a1733;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
}
.guest-block-btn::after { border: none; }

/* 按钮 */
.btn {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}
.btn::after { border: none; }
.btn-primary {
  background: #7a1733;
  color: #fff;
}
.btn-primary[disabled] {
  background: #9d5a6c;
  color: #fff;
}
