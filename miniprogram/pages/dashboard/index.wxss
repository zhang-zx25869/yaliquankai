/* B4 四色看板页样式（设计 token 与 respond/profile 一致） */
.page {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 游客绑定引导 */
.guest-card { display: flex; flex-direction: column; }
.guest-title { font-size: 32rpx; font-weight: bold; margin-bottom: 12rpx; }
.guest-desc { font-size: 26rpx; color: #999; line-height: 1.6; margin-bottom: 24rpx; }
.primary-btn {
  background: #7a1733;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
}

/* 图例 */
.legend { display: flex; flex-wrap: wrap; gap: 12rpx 28rpx; margin-bottom: 12rpx; }
.legend-item { display: flex; align-items: center; }
.legend-dot { width: 20rpx; height: 20rpx; border-radius: 10rpx; margin-right: 8rpx; }
.legend-text { font-size: 24rpx; color: #666; }
.legend-hint { font-size: 22rpx; color: #bbb; margin: 0 0 16rpx 8rpx; display: block; }

/* 看板网格（列宽由 js 拼进 boardStyle） */
.board-scroll { width: 100%; }
.board { padding-bottom: 16rpx; }
.corner {
  font-size: 22rpx;
  color: #bbb;
  display: flex;
  align-items: flex-end;
  padding: 0 0 8rpx 4rpx;
}
.col-head {
  font-size: 20rpx;
  color: #999;
  line-height: 1.3;
  padding: 4rpx;
  word-break: break-all;
}
.row-head {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.row-head text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cell { min-height: 96rpx; }
.cell-empty { color: #ddd; text-align: center; line-height: 96rpx; font-size: 24rpx; }
.chip {
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 76rpx;
  box-sizing: border-box;
}
.chip-vs { font-size: 22rpx; font-weight: 600; }
.chip-status { font-size: 20rpx; opacity: 0.92; }
.chip-extra { font-size: 20rpx; opacity: 0.85; }
/* 已取消比赛：删除线标记（用例13） */
.cell-cancelled .chip-vs { text-decoration: line-through; opacity: 0.75; }
.cell-cancelled .chip-status { opacity: 0.55; }

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 展开详情 */
.detail-area { margin-top: 24rpx; }
.admin-extra { display: flex; gap: 16rpx; margin-top: 16rpx; }

/* 手动修改状态面板 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9;
}
.panel {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 60rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 10;
}
.panel-title { font-size: 32rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.panel-sub { font-size: 24rpx; color: #999; display: block; margin-bottom: 24rpx; }
.radio-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.radio-row text { font-size: 26rpx; color: #333; margin-left: 8rpx; }
.nickname-input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin: 8rpx 0 24rpx;
}
.panel-actions { display: flex; gap: 16rpx; margin-top: 8rpx; }

/* 按钮色：主题 #7a1733 / 红 #e64340 / 橙 #ff8c00（与组件 token 一致） */
.btn-danger { background: #e64340; color: #fff; border-radius: 12rpx; font-size: 26rpx; }
.btn-warn { background: #ff8c00; color: #fff; border-radius: 12rpx; font-size: 26rpx; }
.btn-plain { background: #f5f5f5; color: #666; border-radius: 12rpx; font-size: 26rpx; }
.btn-primary { background: #7a1733; color: #fff; border-radius: 12rpx; font-size: 26rpx; }
