page { background: #f6f6f6; color: #302c2d; }
.home { padding: 32rpx 28rpx 64rpx; }
.page-heading { font-size: 42rpx; font-weight: 700; }
.page-subtitle { margin: 10rpx 0 28rpx; font-size: 24rpx; color: #777; }
.captain-entry, .calendar { padding: 28rpx; background: #fff; border-radius: 20rpx; margin-bottom: 24rpx; }
.entry-title { font-size: 28rpx; font-weight: 600; }
.entry-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.publish-button, .manage-button { flex: 1; margin: 0; font-size: 26rpx; border-radius: 12rpx; }
.publish-button { background: #7a1733; color: #fff; }
.manage-button { background: #faf0f3; color: #7a1733; }
.month-navigation { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.month-title { padding: 12rpx 24rpx; font-size: 32rpx; font-weight: 600; }
.month-arrow { margin: 0; background: #f8f8f8; color: #7a1733; font-size: 32rpx; }
.calendar-grid { display: flex; flex-wrap: wrap; }
.weekday, .day-cell { width: 14.2857%; text-align: center; }
.weekday { font-size: 24rpx; color: #888; padding: 12rpx 0; }
.day-cell { height: 78rpx; display: flex; align-items: center; justify-content: center; }
.day { width: 66rpx; height: 66rpx; padding: 0; margin: 0; line-height: 66rpx; border-radius: 50%; background: transparent; font-size: 26rpx; }
.day::after, .month-arrow::after, .range-button::after { border: none; }
.day-range { background: #faf0f3; }
.day-today { box-shadow: inset 0 0 0 2rpx #7a1733; font-weight: 700; }
.day-selected { background: #7a1733; color: #fff; }
.calendar-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.range-button { flex: 1; margin: 0; background: #f5f5f5; color: #666; }
.range-active { color: #7a1733; background: #faf0f3; }
.calendar-hint { margin-top: 20rpx; font-size: 22rpx; color: #888; text-align: center; }
.section-title { margin: 32rpx 0 12rpx; font-size: 30rpx; font-weight: 600; }
.section-count, .count { font-size: 24rpx; color: #888; font-weight: normal; }
.section-count { margin-bottom: 20rpx; }
.feedback { padding: 40rpx 24rpx; text-align: center; color: #777; background: #fff; border-radius: 16rpx; font-size: 27rpx; }
.retry-button { margin: 20rpx 8rpx 0; color: #7a1733; background: #faf0f3; }
.detail-feedback { margin: -12rpx 0 24rpx; padding: 24rpx; border-radius: 12rpx; font-size: 26rpx; color: #777; background: #fff; }
