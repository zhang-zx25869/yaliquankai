<!-- B5 我的页：身份显示 + 激活码绑定 + 我的跟场（B5b） -->
<view class="container">

  <!-- 身份卡片 -->
  <view class="card">
    <view class="avatar-wrap">
      <image class="avatar" src="/images/avatar.png" mode="aspectFill" />
    </view>
    <view class="info">
      <text class="role">{{roleLabel}}</text>
      <text class="desc">{{roleDesc}}</text>
    </view>
  </view>

  <!-- 游客：激活码绑定入口（用例2） -->
  <view class="card" wx:if="{{userInfo.role === roleGuest}}">
    <text class="card-title">绑定身份</text>
    <text class="card-hint">输入体育部分发的一次性激活码，解锁专属管理权限（队长 / 部员 / 运营者）</text>
    <input
      class="code-input"
      placeholder="请输入激活码"
      value="{{codeInput}}"
      bindinput="onCodeInput"
    />
    <button
      class="bind-btn {{binding ? 'disabled' : ''}}"
      bindtap="onBind"
      disabled="{{binding}}"
    >{{binding ? "绑定中..." : "立即绑定"}}</button>
  </view>

  <!-- 已绑定：功能提示 -->
  <view class="card" wx:else>
    <text class="card-title">我的权限</text>
    <text class="card-hint">身份已与微信永久绑定，后续使用无需重复验证</text>
  </view>

  <!-- B5b 我的跟场（member/admin）：进行中的跟场任务 -->
  <view class="card duty-card" wx:if="{{userInfo.role === roleMember || userInfo.role === roleAdmin}}">
    <text class="card-title">我的跟场</text>
    <text class="card-hint">我当前负责的跟场任务（状态：确认 / 救场 / 待结算）</text>

    <view wx:if="{{loadingDuties}}" class="duty-empty">加载中...</view>

    <block wx:elif="{{myDuties.length}}">
      <match-detail-card
        wx:for="{{myDuties}}"
        wx:key="_id"
        match="{{item}}"
        role="{{userInfo.role}}"
        show-actions
        bind:cancelduty="onCancelDuty"
      />
    </block>

    <view wx:else class="duty-empty">暂无进行中的跟场任务</view>
  </view>

</view>