/* B6 跟场响应页样式：四区卡片布局 */
.page {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); /* iPhone 底部安全区 */
  background: #f6f6f6;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载占位 */
.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ── 区1：比赛信息 ── */
.status-bar {
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.status-bar-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.vs-block {
  text-align: center;
  margin-bottom: 20rpx;
}
.vs {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}
.sport {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.info-row {
  display: flex;
  padding: 12rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.info-label {
  width: 160rpx;
  color: #999;
  font-size: 28rpx;
  flex-shrink: 0;
}
.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.info-confirmer {
  color: #33c275;
  font-weight: 600;
}

/* ── 区2：统计 ── */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.stat-row:last-child { border-bottom: none; }
.stat-name { font-size: 28rpx; color: #333; }
.stat-count { font-size: 28rpx; font-weight: 600; color: #7a1733; }
.stat-empty { color: #999; font-size: 26rpx; text-align: center; padding: 16rpx 0; }

/* 401 游客绑定引导块（替代原 mock 时代不可达的 guest-tip） */
.guest-block {
  background: #fff7f8;
  border: 1rpx solid #f2c7cd;
  border-radius: 16rpx;
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.guest-block-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #7a1733;
}
.guest-block-desc {
  font-size: 26rpx;
  color: #8c5058;
  line-height: 1.6;
  text-align: center;
  margin: 20rpx 0 36rpx;
}
.guest-block-btn {
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #7a1733;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
}
.guest-block-btn::after { border: none; }

/* ── 区3：态度区 ── */
.my-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}
.my-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
}
.my-state-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 按钮通用 */
.btn {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}
.btn::after { border: none; }
.btn-primary {
  background: #7a1733;
  color: #fff;
}
.btn-primary:active { background: #3a76e0; }
.btn-plain {
  background: #fff;
  color: #666;
  border: 2rpx solid #d8d8d8;
}
.btn-warn {
  background: #fff;
  color: #e64340;
  border: 2rpx solid #e64340;
}
.btn-danger {
  background: #e64340;
  color: #fff;
}
.btn-danger:active { background: #d03a37; }

/* ── 区4：求助区 ── */
.help-card {
  border: 2rpx solid #ffe0df;
  background: #fff8f8;
}
.help-title { color: #e64340; }
.help-desc {
  font-size: 26rpx;
  color: #b34a48;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
